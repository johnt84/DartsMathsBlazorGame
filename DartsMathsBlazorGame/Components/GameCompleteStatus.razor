@if (GameState.GameComplete)
@if (GameState.GameComplete)
{
    if (GameState.HighestScoreBeaten)
    {
        <MudText Typo="Typo.body2" Class="pt-4 pl-4">
            Congratulations, you beat the highest score!
        </MudText>
    }

    <MudText Typo="Typo.body2" Class="pt-4 pl-4">
        You got @GameState.NumberOfCorrectAnswers out of @GameState.TotalQuestionsAnswered correct!
    </MudText>
}

@code{
    [Parameter]
    public GameState GameState { get; set; } = null!;
}